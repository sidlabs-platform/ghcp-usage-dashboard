# Environment Variables for GitHub Copilot Usage Dashboard

# ── Single-Enterprise Mode (Legacy) ──────────────────────────────────
# These env vars work for a single enterprise. For multiple enterprises,
# use dashboard-config.json instead (see Multi-Enterprise section below).

# Required: GitHub Personal Access Token
# Enterprise endpoints: needs manage_billing:copilot or read:enterprise scope
# Organization endpoints: needs read:org scope
# Enterprise Teams: needs read:enterprise scope (classic PAT)
# GHAS (Security): needs security_events scope for code scanning, Dependabot, and secret scanning alerts
#   Fine-grained PAT alternative: code_scanning_alerts:read, dependabot_alerts:read, secret_scanning_alerts:read
# Note: GITHUB_TOKEN is optional when GitHub App auth is configured and enterprise mode is disabled.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required for enterprise mode: Enterprise slug (as shown in GitHub URL)
# Omit this to use org-only mode (see below).
GITHUB_ENTERPRISE=your-enterprise-slug

# Optional: Comma-separated list of organization slugs to track
# If empty, the dashboard will try to discover orgs from the enterprise
GITHUB_ORGS=org1,org2,org3

# Optional: Number of days to backfill on first setup (default: 90, max: 365)
BACKFILL_DAYS=90

# Optional: GitHub API base URL (for GHES installations)
# GITHUB_API_BASE=https://api.github.com

# ── Org-Only Mode ─────────────────────────────────────────────────────
# For organization admins without enterprise access. Set GITHUB_ORGS
# without GITHUB_ENTERPRISE.
#
# Required: PAT with read:org scope (or GitHub App with org-level permissions)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GITHUB_ORGS=org1,org2,org3
#
# In org-only mode the dashboard uses organization-level API endpoints:
#   - /orgs/{org}/copilot/metrics/reports/organization-1-day (org aggregate)
#   - /orgs/{org}/copilot/metrics/reports/users-1-day (user-level metrics)
#   - /orgs/{org}/copilot/billing/seats (seat assignments)
#   - /orgs/{org}/teams (team memberships)
#
# The following features are automatically disabled:
#   - Enterprise-level aggregate metrics
#   - Billing / metered usage / premium request reports
#   - Enterprise team discovery
#   - Enterprise org auto-discovery (orgs must be listed explicitly)

# ── GitHub App Authentication (optional, single enterprise) ───────────
# When all 3 values below are set, the dashboard uses App auth for org/repo
# endpoints and PAT only for enterprise endpoints. See README for setup guide.
# In org-only mode, App auth handles all API calls (PAT is not required).

# GitHub App ID (numeric, from your App's settings page)
# GITHUB_APP_ID=123456

# GitHub App private key (PEM format, use \n for newlines)
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"

# GitHub App installation ID (numeric, from your App's installation URL)
# GITHUB_APP_INSTALLATION_ID=78901234

# ── Multi-Enterprise Mode ─────────────────────────────────────────────
# To track multiple enterprises, add an "enterprises" array in dashboard-config.json
# and set per-enterprise env vars. Example:
#
# dashboard-config.json:
#   {
#     "enterprises": [
#       {
#         "slug": "enterprise-one",
#         "displayName": "Enterprise One",
#         "tokenEnvVar": "GITHUB_TOKEN_ENT1",
#         "appIdEnvVar": "GITHUB_APP_ID_ENT1",
#         "appPrivateKeyEnvVar": "GITHUB_APP_KEY_ENT1",
#         "appInstallationIdEnvVar": "GITHUB_APP_INST_ENT1",
#         "organizations": { "include": ["org1", "org2"] }
#       },
#       {
#         "slug": "enterprise-two",
#         "displayName": "Enterprise Two",
#         "tokenEnvVar": "GITHUB_TOKEN_ENT2",
#         "organizations": { "include": ["org3"] }
#       }
#     ],
#     ...
#   }
#
# Then set the corresponding env vars:
# GITHUB_TOKEN_ENT1=ghp_aaaa...
# GITHUB_TOKEN_ENT2=ghp_bbbb...
# GITHUB_APP_ID_ENT1=123456
# GITHUB_APP_KEY_ENT1="-----BEGIN RSA PRIVATE KEY-----\n..."
# GITHUB_APP_INST_ENT1=78901234
#
# When "enterprises" is present in config, GITHUB_ENTERPRISE/GITHUB_TOKEN/GITHUB_ORGS
# are ignored. Each enterprise uses its own tokenEnvVar for PAT auth.
#
# ── Org-Only Entries in Multi-Enterprise Config ───────────────────────
# You can mix enterprise and org-only entries. Set copilot.enterprise: false
# and billing.enabled: false to skip enterprise endpoints for that entry.
# `tokenEnvVar` is required only when GitHub App auth env vars are not set;
# with App auth configured, the PAT is optional for org-only entries.
#
#   {
#     "slug": "my-org-group",
#     "displayName": "My Organizations",
#     "tokenEnvVar": "GITHUB_TOKEN_ORGS",
#     "organizations": { "include": ["org4", "org5"] },
#     "metrics": {
#       "copilot": { "enterprise": false },
#       "billing": { "enabled": false }
#     }
#   }
