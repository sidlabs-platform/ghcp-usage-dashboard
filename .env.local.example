# Environment Variables for GitHub Copilot Usage Dashboard

# Required: GitHub Personal Access Token
# Enterprise endpoints: needs manage_billing:copilot or read:enterprise scope
# Organization endpoints: needs read:org scope
# Enterprise Teams: needs read:enterprise scope (classic PAT)
# GHAS (Security): needs security_events scope for code scanning, Dependabot, and secret scanning alerts
#   Fine-grained PAT alternative: code_scanning_alerts:read, dependabot_alerts:read, secret_scanning_alerts:read
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required: Enterprise slug (as shown in GitHub URL)
GITHUB_ENTERPRISE=your-enterprise-slug

# Optional: Comma-separated list of organization slugs to track
# If empty, the dashboard will try to discover orgs from the enterprise
GITHUB_ORGS=org1,org2,org3

# Optional: Number of days to backfill on first setup (default: 90, max: 365)
BACKFILL_DAYS=90

# Optional: GitHub API base URL (for GHES installations)
# GITHUB_API_BASE=https://api.github.com
